---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---
<div class:list={['container', className]}><slot /></div>

<style>
  .container {
    max-width: var(--l-max-width);
    margin-inline: auto;
    padding-inline: var(--l-gutter);
    position: relative;
  }
</style>
