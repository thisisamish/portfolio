---
import Container from '../../components/Container.astro';
import { inline } from '../../lib/inline';
import type { AboutContent } from './schema';

interface Props {
  content: AboutContent;
}
const { content } = Astro.props;
const { portrait } = content;
---
<section class="about">
  <Container>
    <p class="kicker label">{content.kicker}</p>
    <div class="grid">
      <figure>
        <div class="portrait" role="img" aria-label={portrait.alt}>
          {portrait.src ? (
            <img src={portrait.src} alt="" loading="lazy" />
          ) : (
            <svg viewBox="0 0 400 500" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
              <circle cx="200" cy="190" r="78" fill="var(--c-bg)" opacity=".16" />
              <path d="M40 500 C40 390 120 330 200 330 C280 330 360 390 360 500 Z" fill="var(--c-bg)" opacity=".16" />
            </svg>
          )}
        </div>
        {portrait.caption && !portrait.src && <figcaption>{portrait.caption}</figcaption>}
      </figure>
      <div class="copy">
        <p class="lead">{content.lead}</p>
        {content.paragraphs.map((p) => <p class="para" set:html={inline(p)} />)}
        <p class="label films-label">{content.filmsLabel}</p>
        <div class="films">
          {content.films.map((f, i) => (
            <div class="film" style={`--tint:${14 + i * 12}%`}>
              <b>{f.title}</b>
              <span>{f.year}</span>
            </div>
          ))}
        </div>
        {content.draft && <p class="draft">Draft copy for layout only.</p>}
      </div>
    </div>
  </Container>
</section>

<style>
  .about { background: var(--c-bg2); border-block: 1px solid var(--c-line); padding-block: clamp(56px, 10vh, 120px); }
  .kicker { color: var(--c-muted); margin: 0 0 clamp(24px, 4vh, 44px); }
  .grid { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: clamp(32px, 6vw, 96px); align-items: start; }
  figure { margin: 0; }
  .portrait { position: relative; aspect-ratio: 4 / 5; max-width: 100%; overflow: hidden; border-radius: var(--l-radius); background: linear-gradient(165deg, var(--c-ph-a), var(--c-ph-b)); }
  .portrait svg, .portrait img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .portrait::after {
    content: ""; position: absolute; inset: 0; opacity: .35; mix-blend-mode: overlay; pointer-events: none;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 .5 0 0 0 0 .5 0 0 0 0 .5 0 0 0 1.4 -.2'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
  }
  figcaption { margin-top: 12px; font: 400 0.72rem/1.5 var(--f-mono); letter-spacing: 0.06em; color: var(--c-muted); }
  .copy { min-width: 0; }
  .lead { font-size: clamp(1.4rem, 2.4vw, 2rem); line-height: 1.3; letter-spacing: -0.015em; font-weight: 500; margin: 0 0 24px; text-wrap: balance; }
  .para { max-width: 62ch; margin: 0 0 18px; color: var(--c-muted); }
  .para :global(strong) { color: var(--c-ink); font-weight: 500; }
  .films-label { margin: 40px 0 16px; }
  .films { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; max-width: 520px; }
  .film {
    aspect-ratio: 2 / 3; border-radius: 3px; padding: 10px; display: flex; flex-direction: column; justify-content: flex-end; gap: 2px;
    border: 1px solid var(--c-line); background: linear-gradient(160deg, var(--c-bg), color-mix(in srgb, var(--c-accent) var(--tint, 20%), var(--c-bg)));
  }
  .film b { font-size: 0.78rem; font-weight: 500; line-height: 1.25; }
  .film span { font: 400 0.66rem/1.2 var(--f-mono); color: var(--c-muted); }
  .draft { margin: 28px 0 0; font: 400 0.72rem/1.4 var(--f-mono); letter-spacing: 0.08em; color: var(--c-muted); }
  @media (max-width: 820px) { .grid { grid-template-columns: minmax(0, 1fr); } .portrait { max-width: 340px; } }
</style>
